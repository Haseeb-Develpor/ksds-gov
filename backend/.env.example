PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/ksa_skilled
JWT_SECRET=change-me-in-production
JWT_EXPIRES=7d
CLIENT_URL=http://localhost:5173

# WhatsApp OTP (Meta Cloud API — recommended)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional approved OTP template (required for production outbound OTP)
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en_US

# Or Twilio WhatsApp (alternative)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Show OTP in API response for debugging (set false in production)
OTP_DEBUG=true

# Admin business mail (info@ksds-gov.com)
MAIL_FROM=info@ksds-gov.com
MAIL_FROM_NAME=KSA Skilled Development
MAIL_SMTP_HOST=smtp.hostinger.com
MAIL_SMTP_PORT=465
MAIL_SMTP_SECURE=true
MAIL_SMTP_USER=info@ksds-gov.com
MAIL_SMTP_PASS=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
