{
  "name": "ksa-skilled-development",
  "version": "1.0.0",
  "private": true,
  "description": "KSA Skilled Development — Enterprise Web Portal",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "build": "node -e \"require('fs').accessSync('frontend/dist/index.html'); console.log('Using prebuilt frontend/dist')\"",
    "build:frontend": "npm run build:vite --prefix frontend",
    "preview": "npm run build && npm run preview:server",
    "preview:server": "npm run preview --prefix backend",
    "tunnel": "npx localtunnel --port 5000",
    "preview:api": "node preview-server.js",
    "preview:live": "concurrently -n api,web,tunnel -c green,blue,cyan \"node preview-server.js\" \"npm run dev --prefix frontend\" \"npx --yes localtunnel --port 5173\"",
    "postinstall": "npm install --omit=dev --prefix ./backend",
    "start": "node backend/src/index.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
